# Whitebox agent secrets template (Pillar E).
#
# The git-based collaborative-registry path needs NO token:
#   - CI fan-out uses the GitHub Actions-provided GITHUB_TOKEN.
#   - Local registry pushes use the modeler's own git credentials.
#
# This file documents keys needed ONLY when an optional, deferred capability
# that requires an external key is enabled. Copy to `.venv_agent/.env` and fill
# in values when you turn one of those on. The real `.env` is gitignored.

# Optional remote-registry service (only if you choose the remote-store variant
# instead of the dedicated git ref):
WHITEBOX_REGISTRY_API_URL=
WHITEBOX_REGISTRY_API_KEY=

# Optional: running the (deferred) tiered dev agents programmatically:
ANTHROPIC_API_KEY=
